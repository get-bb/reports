+const WORKSPACE_ROOT_ALWAYS_IGNORED_GLOBS = [
+  "**/.git",
+  "**/node_modules",
+  "**/.cache",
+  "**/__pycache__",
+];
 const WORKSPACE_ROOT_IGNORE_STATUS_TIMEOUT_MS = 5_000;
